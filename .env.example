# Local development defaults. Copy this file to .env and replace each secret.
ENVIRONMENT=development
PORT=4000
AUTH_SERVICE_URL=http://127.0.0.1:8001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Generate unique values; never use these placeholders in production.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_INTERNAL_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SESSION_SECRET=replace-with-another-random-secret
DOCTOR_PROVISIONING_KEY=replace-with-a-random-provisioning-key

# Development-only fictional report; token and PIN are still required to sign in.
DEMO_REPORT_ENABLED=false
DEMO_REPORT_PIN=246810

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# Leave SMS settings empty for local development; the generated code is shown in the UI.
# For real SMS delivery, configure these for your SMS provider.
SMS_PROVIDER=
SMS_API_KEY=
SMS_PROVIDER_URL=
SMS_SENDER=

# Leave DATABASE_URL unset locally: the API uses embedded PostgreSQL and auth uses SQLite.
# Set DATABASE_URL to a shared PostgreSQL connection string when deploying both services.
# DATABASE_URL=postgresql://user:password@host:5432/database

OPEN_HOUR=8
CLOSE_HOUR=20
